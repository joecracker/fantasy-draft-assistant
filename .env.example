# GEMINI_API_KEY: Required for Gemini AI API calls.
# Set this as a Netlify environment variable (Site settings -> Environment variables).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: OAuth Client ID for Google Drive backup (see GOOGLE_DRIVE_SETUP.md).
# Public identifier, not a secret. Leave blank to disable Drive backup (local export/import still works).
VITE_GOOGLE_CLIENT_ID=""
