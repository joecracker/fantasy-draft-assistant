# VITE_GOOGLE_CLIENT_ID: OAuth Client ID for Google Drive backup (see GOOGLE_DRIVE_SETUP.md).
# Public identifier, not a secret. Leave blank to disable Drive backup (local export/import still works).
VITE_GOOGLE_CLIENT_ID=""

# --- Yahoo Live Draft Sync (READ-ONLY) ---
# Two codes from your Yahoo developer app (https://developer.yahoo.com/apps/).
# Needed only for Yahoo sync — currently unused until this app has a backend host again.
# The app requests READ-ONLY fantasy access (scope fspt-r) — it can never
# draft, edit, or change anything in your Yahoo account.
YAHOO_CLIENT_ID=""
YAHOO_CLIENT_SECRET=""
