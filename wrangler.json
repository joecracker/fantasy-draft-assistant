{
  "name": "fantasy-draft-assistant",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "./.worker/index.js",
  "routes": [
    {
      "pattern": "fire.crackerbox.app",
      "custom_domain": true
    }
  ]
}
